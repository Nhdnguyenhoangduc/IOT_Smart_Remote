  {"id":"sub_status_node","type":"mqtt in","z":"flow_ir_climate_clean","name":"Nhận Status ESP32","topic":"ir/+/status","qos":"1","datatype":"json","broker":"mqtt_broker_shared","nl":false,"rap":true,"rh":0,"inputs":0,"x":140,"y":60,"wires":[["dbg_status_node","fn_parse_status_node"]]},
  {"id":"dbg_status_node","type":"debug","z":"flow_ir_climate_clean","name":"Status Debug","active":true,"tosidebar":true,"complete":"payload","x":380,"y":40,"wires":[]},
  {"id":"fn_parse_status_node","type":"function","z":"flow_ir_climate_clean","name":"Parse Status","func":"var p = msg.payload;\nvar txt = 'Trạng thái: ' + (p.state || 'N/A');\nif (p.fw) txt += ' | FW: ' + p.fw;\nif (p.rssi) txt += ' | WiFi: ' + p.rssi + 'dBm';\nif (p.info) txt += ' (' + p.info + ')';\nreturn { payload: txt };","outputs":1,"x":370,"y":80,"wires":[["ui_txt_status_node"]]},
  {"id":"ui_txt_status_node","type":"ui_text","z":"flow_ir_climate_clean","group":"grp_ota","order":1,"width":6,"height":2,"name":"Device Status","label":"Thiết bị","format":"{{msg.payload}}","layout":"col-center","x":570,"y":80,"wires":[]},

  {"id":"ui_in_version","type":"ui_text_input","z":"flow_ir_climate_clean","name":"Input Version","label":"Phiên bản (Version):","tooltip":"Ví dụ: 1.0.3","group":"grp_ota","order":2,"width":6,"height":1,"passthru":true,"mode":"text","delay":300,"topic":"version","sendOnBlur":true,"className":"","x":140,"y":120,"wires":[["fn_store_ota_params"]]},
  {"id":"ui_in_url","type":"ui_text_input","z":"flow_ir_climate_clean","name":"Input URL","label":"Link Firmware (.bin URL):","tooltip":"Đường dẫn tải firmware từ GitHub Release","group":"grp_ota","order":3,"width":6,"height":1,"passthru":true,"mode":"text","delay":300,"topic":"url","sendOnBlur":true,"className":"","x":130,"y":160,"wires":[["fn_store_ota_params"]]},
  {"id":"ui_in_sha256","type":"ui_text_input","z":"flow_ir_climate_clean","name":"Input SHA256","label":"Mã SHA256:","tooltip":"Dán chuỗi SHA256 (64 ký tự) vào đây","group":"grp_ota","order":4,"width":6,"height":1,"passthru":true,"mode":"text","delay":300,"topic":"sha256","sendOnBlur":true,"className":"","x":140,"y":200,"wires":[["fn_store_ota_params"]]},

  {"id":"fn_store_ota_params","type":"function","z":"flow_ir_climate_clean","name":"Lưu thông tin OTA","func":"if (msg.topic === 'version') flow.set('ota_version', msg.payload);\nif (msg.topic === 'url') flow.set('ota_url', msg.payload);\nif (msg.topic === 'sha256') flow.set('ota_sha256', msg.payload);\nreturn null;","outputs":1,"x":370,"y":160,"wires":[[]]},

  {"id":"ui_btn_ota","type":"ui_button","z":"flow_ir_climate_clean","name":"Nút Cập Nhật OTA","group":"grp_ota","order":5,"width":6,"height":1,"passthru":false,"label":"BẮT ĐẦU NÂNG CẤP (OTA)","tooltip":"Bấm để gửi lệnh nâng cấp firmware với các thông số vừa nhập","color":"#fff","bgcolor":"#d32f2f","icon":"system_update_alt","payload":"go","payloadType":"str","topic":"","x":150,"y":240,"wires":[["fn_ota_cmd_node"]]},

  {"id":"fn_ota_cmd_node","type":"function","z":"flow_ir_climate_clean","name":"Tạo lệnh OTA","func":"const devId = 'irb-FD51A9B2D08C';\n\n// Lấy giá trị nhập từ UI (nếu chưa nhập thì lấy giá trị mặc định)\nlet version = flow.get('ota_version') || '1.0.3';\nlet url = flow.get('ota_url') || 'https://github.com/Nhdnguyenhoangduc/IOT_Smart_Remote/releases/download/v1.0.3/firmware.bin';\nlet sha256 = flow.get('ota_sha256') || 'c874b33ad91503e3228a307b99a13b772e008a652a927fa1e5d3fc3c95982855';\n\n// Chuẩn hóa SHA256: bỏ tiền tố thừa sha256: nếu người dùng lỡ copy đúp\nsha256 = sha256.trim();\nwhile (sha256.startsWith('sha256:')) {\n    sha256 = sha256.substring(7);\n}\n\nmsg.topic = `ir/${devId}/cmd/ota`;\nmsg.payload = {\n    version: version.trim(),\n    url: url.trim(),\n    sha256: sha256.trim()\n};\nmsg.qos = 1;\nreturn msg;","outputs":1,"x":360,"y":240,"wires":[["pub_mqtt_node"]]},

  {"id":"sub_dht_node","type":"mqtt in","z":"flow_ir_climate_clean","name":"Nhận dữ liệu DHT11","topic":"ir/+/dht","qos":"1","datatype":"json","broker":"mqtt_broker_shared","nl":false,"rap":true,"rh":0,"inputs":0,"x":140,"y":320,"wires":[["fn_split_dht_node"]]},
  {"id":"fn_split_dht_node","type":"function","z":"flow_ir_climate_clean","name":"Tách T & H","func":"var t = { payload: msg.payload.temp };\nvar h = { payload: msg.payload.hum };\nreturn [t, h];","outputs":2,"x":350,"y":320,"wires":[["ui_gage_temp_node","ui_line_chart_node"],["ui_gage_hum_node","ui_line_chart_node"]]},
