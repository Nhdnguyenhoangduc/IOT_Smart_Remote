  {"id":"sub_learned_node","type":"mqtt in","z":"flow_ir_climate_clean","name":"Nhận mã học được","topic":"ir/+/learned","qos":"1","datatype":"json","broker":"mqtt_broker_shared","nl":false,"rap":true,"rh":0,"inputs":0,"x":140,"y":840,"wires":[["fn_parse_learned_node"]]},
  {"id":"fn_parse_learned_node","type":"function","z":"flow_ir_climate_clean","name":"Hiển thị mã học","func":"var p = msg.payload;\nvar out = 'ĐÃ HỌC ĐƯỢC MÃ:\\n';\nout += 'Protocol: ' + p.protocol + '\\n';\nout += 'Code: ' + p.code + '\\n';\nout += 'Bits: ' + p.bits;\nif (p.raw) {\n    out += '\\nRAW (' + p.raw.length + ' xung): [' + p.raw.slice(0, 10).join(', ') + '...]';\n}\nreturn { payload: out };","outputs":1,"x":380,"y":840,"wires":[["ui_txt_learned_node"]]},
